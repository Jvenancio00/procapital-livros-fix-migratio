// Esquema da base de dados da Pro Capital — Plataforma Editorial & Comércio B2B Lusófono
// Compatível com PostgreSQL (Neon, Vercel Postgres, RDS e PostgreSQL local).

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum Currency {
  KZ
  MT
  EUR
  BRL
}

enum MarketCode {
  AO
  MZ
  PT
  BR
}

enum EducationLevel {
  ENSINO_PRIMARIO
  ENSINO_SECUNDARIO
  TECNICO_PROFISSIONAL
  ENSINO_SUPERIOR
  GERAL
}

enum OrderStatus {
  DRAFT
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING_TRANSFER
  UNDER_REVIEW
  CONFIRMED
  FAILED
  REFUNDED
}

enum StockMovementType {
  INITIAL_SEED
  IMPORT_IN
  MANUAL_ADJUSTMENT
  CHECKOUT_RESERVE
  RESERVATION_RELEASE
  SALE_CONFIRMED
  ORDER_REFUND
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum ImportMode {
  UPDATE_STOCK
  UPDATE_PRICES
  IMPORT_BOOKS
  COMBINED
}

enum QuoteStatus {
  PENDING
  IN_REVIEW
  QUOTED
  APPROVED
  CONVERTED_ORDER
  REJECTED
}

enum NoteKind {
  BOOKMARK
  NOTE
}

enum TipoInstituicao {
  ESCOLA
  UNIVERSIDADE
  LIVRARIA
  EDITORA
  OUTRO
}

enum EstadoConvenio {
  PENDENTE
  EM_ANALISE
  APROVADO
  REJEITADO
}

enum TipoEvento {
  LANCAMENTO
  FEIRA
  WORKSHOP
  OUTRO
}

enum EstadoInscricao {
  CONFIRMADA
  LISTA_ESPERA
  CANCELADA
}

enum ClientType {
  PARTICULAR
  LIVRARIA
  REVENDEDOR
  ESCOLA
  UNIVERSIDADE
  EDITORA
  EMPRESA_INSTITUICAO
  DISTRIBUIDOR_PARCEIRO
}

enum ContactReason {
  PUBLICAR
  COMPRAR
  PARCERIA
  SUPORTE_TECNICO
  COMERCIAL
  OUTRO
  EDITORA
  LIVRARIA
  ESCOLA
  PARCEIRO_COMERCIAL
  INVESTIMENTO
  LEITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  totpSecret  String?
  totpEnabled Boolean @default(false)

  orders                  Order[]
  reviews                 Review[]
  favorites               Favorite[]
  library                 LibraryItem[]
  readingNotes            ReadingNote[]
  clientProfile           ClientProfile?
  loginEvents             LoginEvent[]
  quoteRequests           QuoteRequest[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  success   Boolean  @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String  @unique
  description String?
  faq         Json?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  books Book[]

  @@index([parentId])
}

model Editora {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String  @unique
  country     String?
  logo        String?
  phone       String?
  email       String?
  address     String?
  website     String?
  description String?

  books Book[]
}

model Book {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  author         String
  editora        String
  description    String?
  isbn           String?
  isbnNormalized String?         @unique
  coverUrl       String?
  pdfUrl         String?
  pages          Int?
  year           Int?
  free           Boolean         @default(false)
  active         Boolean         @default(true)
  educationLevel EducationLevel?
  schoolGrade    String?
  subject        String?
  academicYear   Int?
  countryOrigin  String?
  allowPreorder  Boolean         @default(false)
  allowQuote     Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  featured     Boolean   @default(false)
  featuredFrom DateTime?
  featuredTo   DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  editoraId  String?
  editoraRef Editora? @relation(fields: [editoraId], references: [id])

  prices       Price[]
  stockItems   StockItem[]
  orderItems   OrderItem[]
  quoteItems   QuoteItem[]
  reviews      Review[]
  favorites    Favorite[]
  libraryOf    LibraryItem[]
  readingNotes ReadingNote[]
  licenses     License[]

  @@index([isbnNormalized])
  @@index([educationLevel, schoolGrade])
  @@index([active, featured])
}

model MarketConfig {
  code                  MarketCode @id
  name                  String
  currency              Currency
  isoCurrency           String
  taxRatePercent        Decimal    @default(0)
  shippingFlatFee       Decimal    @default(0)
  freeShippingThreshold Decimal?
  estimatedDeliveryDays String     @default("2 a 5 dias úteis")
  bankTransferEnabled   Boolean    @default(true)
  bankAccountDetails    String?
  localMethodName       String?
  localMethodEnabled    Boolean    @default(false)
  cardGatewayEnabled    Boolean    @default(false)
  quoteEnabled          Boolean    @default(true)
  active                Boolean    @default(true)
  updatedAt             DateTime   @updatedAt
}

model Warehouse {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  countryCode MarketCode
  city        String
  address     String?
  isPrimary   Boolean    @default(false)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  stockItems StockItem[]

  @@index([countryCode, active])
}

model StockItem {
  id                String   @id @default(cuid())
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([bookId, warehouseId])
  @@index([warehouseId])
}

model StockReservation {
  id         String            @id @default(cuid())
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, expiresAt])
}

model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  delta       Int
  previousQty Int
  newQty      Int
  reason      String?
  actorId     String?
  actorEmail  String?
  orderId     String?
  createdAt   DateTime          @default(now())

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
  @@index([createdAt])
}

model ImportBatch {
  id              String     @id @default(cuid())
  filename        String
  mode            ImportMode @default(COMBINED)
  status          String     @default("COMPLETED")
  selectedActions Json?
  totalRows       Int        @default(0)
  validRows       Int        @default(0)
  createdBooks    Int        @default(0)
  updatedStock    Int        @default(0)
  updatedPrices   Int        @default(0)
  skippedRows     Int        @default(0)
  errorRows       Int        @default(0)
  summaryJson     Json?
  reportJson      Json?
  actorId         String?
  actorEmail      String?
  createdAt       DateTime   @default(now())

  movements StockMovement[]

  @@index([createdAt])
}

model Price {
  id              String   @id @default(cuid())
  amount          Decimal
  currency        Currency
  marketActive    Boolean  @default(true)
  minWholesaleQty Int?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, currency])
}

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String?       @unique
  status               OrderStatus   @default(PENDING)
  currency             Currency      @default(KZ)
  countryCode          MarketCode    @default(MZ)
  buyerName            String?
  buyerEmail           String?
  buyerPhone           String?
  buyerTaxId           String?
  companyName          String?
  clientType           ClientType    @default(PARTICULAR)
  shippingAddress      String?
  shippingCity         String?
  shippingPostalCode   String?
  subtotalAmount       Decimal       @default(0)
  discountAmount       Decimal       @default(0)
  taxAmount            Decimal       @default(0)
  shippingAmount       Decimal       @default(0)
  totalAmount          Decimal
  paymentMethod        String?
  paymentStatus        PaymentStatus @default(UNPAID)
  paymentReference     String?
  invoiceRequested     Boolean       @default(false)
  notes                String?
  reservationExpiresAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now()) @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items        OrderItem[]
  reservations StockReservation[]
  payments     PaymentRecord[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                String    @id @default(cuid())
  quantity          Int
  unitPrice         Decimal
  titleSnapshot     String?
  isbnSnapshot      String?
  publisherSnapshot String?
  currencySnapshot  Currency?
  discountPercent   Int       @default(0)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  @@index([bookId])
}

model PaymentRecord {
  id                  String        @id @default(cuid())
  provider            String
  method              String
  amount              Decimal
  currency            Currency
  status              PaymentStatus @default(PENDING_TRANSFER)
  externalReference   String?
  transferProofRef    String?
  notes               String?
  reviewedByEmail     String?
  reviewedAt          DateTime?
  confirmedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  eventType   String
  orderId     String?
  signatureOk Boolean  @default(false)
  payloadJson Json?
  processedAt DateTime @default(now())
}

model QuoteRequest {
  id                String      @id @default(cuid())
  quoteNumber       String      @unique
  status            QuoteStatus @default(PENDING)
  contactName       String
  email             String
  phone             String?
  organizationName  String?
  taxId             String?
  clientType        ClientType  @default(ESCOLA)
  countryCode       MarketCode  @default(MZ)
  currency          Currency    @default(MT)
  academicYear      Int?
  deliveryAddress   String?
  notes             String?
  estimatedTotal    Decimal?
  quotedTotal       Decimal?
  adminNotes        String?
  validUntil        DateTime?
  convertedOrderId  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items QuoteItem[]

  @@index([status, createdAt])
  @@index([email])
}

model QuoteItem {
  id              String   @id @default(cuid())
  bookSlug        String?
  bookTitle       String
  isbn            String?
  publisher       String?
  quantity        Int
  unitPriceQuoted Decimal?
  notes           String?

  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  bookId String?
  book   Book?   @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([quoteRequestId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Favorite {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  priceAtSaveKZ Decimal?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model LibraryItem {
  id         String   @id @default(cuid())
  acquiredAt DateTime @default(now())
  source     String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model ReadingNote {
  id        String   @id @default(cuid())
  page      Int
  kind      NoteKind
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
}

model License {
  id          String    @id @default(cuid())
  code        String    @unique @default(cuid())
  buyerEmail  String
  maxDevices  Int       @default(1)
  devicesUsed Int       @default(0)
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model ConvenioPedido {
  id          String          @id @default(cuid())
  nome        String
  instituicao String
  tipo        TipoInstituicao
  email       String
  telefone    String?
  numAlunos   Int?
  mensagem    String?
  estado      EstadoConvenio  @default(PENDENTE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([estado])
}

model Evento {
  id         String     @id @default(cuid())
  slug       String     @unique
  titulo     String
  tipo       TipoEvento @default(OUTRO)
  descricao  String
  local      String
  endereco   String?
  latitude   Float?
  longitude  Float?
  imageUrl   String?
  dataInicio DateTime
  dataFim    DateTime?
  capacidade Int?
  editora    String?
  livroSlug  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  inscricoes Inscricao[]

  @@index([dataInicio])
}

model Inscricao {
  id          String          @id @default(cuid())
  nome        String
  email       String
  telefone    String?
  estado      EstadoInscricao @default(CONFIRMADA)
  createdAt   DateTime        @default(now())
  checkinCode String          @unique @default(cuid())
  checkedInAt DateTime?

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([eventoId, email])
}

model ClientProfile {
  id               String     @id @default(cuid())
  companyName      String?
  type             ClientType @default(PARTICULAR)
  discountPercent  Int        @default(0)
  taxId            String?
  countryCode      MarketCode @default(MZ)
  phone            String?
  billingAddress   String?
  city             String?
  contactRole      String?
  approvedB2B      Boolean    @default(false)
  paymentTermsDays Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverUrl    String?
  authorName  String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

model ContactRequest {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  reason    ContactReason
  message   String
  createdAt DateTime      @default(now())

  @@index([reason, createdAt])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  source       String?
  confirmed    Boolean  @default(false)
  unsubscribed Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model EmailLog {
  id           String   @id @default(cuid())
  template     String
  recipient    String
  subject      String
  status       String
  provider     String?
  errorMessage String?
  metaJson     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  actorId     String?
  actorEmail  String?
  ip          String?
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
