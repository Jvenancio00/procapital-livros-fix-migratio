# Copia este ficheiro para ".env" e preenche com os teus valores reais.
# NUNCA envies o ficheiro ".env" (com valores reais) para o GitHub.

# Connection string da tua base de dados PostgreSQL (Neon, Vercel Postgres ou PostgreSQL local)
DATABASE_URL="postgres://utilizador:password@host/base_de_dados?sslmode=require"

# Chave secreta do NextAuth — gera uma com: npx auth secret
AUTH_SECRET=""

# URL pública do site em produção (ex.: https://www.procapitalmz.com)
NEXT_PUBLIC_SITE_URL="https://www.procapitalmz.com"

# Cria o primeiro administrador ao correr "npm run seed" — depois disso,
# a gestão de administradores e permissões faz-se na base de dados (User.role).
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Serviço de email transacional (escolhe SMTP OU Resend — sem configuração, o
# sistema regista honestamente o estado sem declarar envio simulado)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="Pro Capital <comercial@procapitalmz.com>"
ADMIN_ALERT_EMAIL="comercial@procapitalmz.com"

# Pagamentos externos verificados (opcionais — ativados apenas quando configurados)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_WEBHOOK_HMAC_SECRET=""
MPESA_API_KEY=""

# Opcional: serve o vídeo/imagem do banner principal a partir de uma CDN
NEXT_PUBLIC_HERO_VIDEO_URL=""
NEXT_PUBLIC_HERO_POSTER_URL=""
